<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/streamStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/stream_connecting"
        android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/streamProgress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    <Button android:id="@+id/streamPause" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/stream_pause" android:enabled="false" />
</LinearLayout>
