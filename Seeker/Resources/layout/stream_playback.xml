<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:scrollbars="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <ImageView android:id="@+id/streamArtwork" android:layout_width="match_parent"
            android:layout_height="@dimen/stream_player_artwork_height" android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" android:scaleType="fitCenter"
            android:importantForAccessibility="no" android:src="@drawable/stream_artwork_placeholder" />
        <TextView android:id="@+id/streamArtist" android:textColor="?attr/normalTextColor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/streamAlbum" android:textColor="?attr/cellTextColorSubdued" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="4dp"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <TextView android:id="@+id/streamStatus" android:textColor="?attr/mainTextColor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/stream_connecting"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/streamProgress" android:textColor="?attr/cellTextColorSubdued" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/streamOpenFolder" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/stream_open_folder"
            android:textAllCaps="false" android:enabled="false"
            app:icon="@drawable/folder_outline" app:iconGravity="textStart" />
        <SeekBar android:id="@+id/streamSeekBar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="1000" android:enabled="false"
            android:progressTint="?attr/colorPrimary" android:thumbTint="?attr/colorPrimary"
            android:contentDescription="@string/stream_seek" />
        <TextView android:id="@+id/streamSeekStatus" android:textColor="?attr/cellTextColorSubdued" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center_horizontal" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/streamPrevious" style="@style/StreamPlayerIcon"
                android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/stream_previous" android:contentDescription="@string/stream_previous" />
            <ImageButton android:id="@+id/streamPause" style="@style/StreamPlayerIcon"
                android:layout_width="72dp" android:layout_height="72dp" android:padding="18dp"
                android:tint="?attr/colorPrimary" android:src="@drawable/stream_play"
                android:contentDescription="@string/stream_play" android:enabled="false" />
            <ImageButton android:id="@+id/streamNext" style="@style/StreamPlayerIcon"
                android:layout_width="64dp" android:layout_height="64dp"
                android:src="@drawable/stream_next" android:contentDescription="@string/stream_next" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/streamQueue" style="@style/StreamPlayerIcon"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:src="@drawable/stream_queue" android:contentDescription="@string/stream_queue" />
            <ImageButton android:id="@+id/streamRepeat" style="@style/StreamPlayerIcon"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:src="@drawable/stream_repeat_off" android:contentDescription="@string/stream_repeat_off" />
            <ImageButton android:id="@+id/streamAutoplay" style="@style/StreamPlayerIcon"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:src="@drawable/stream_autoplay" android:contentDescription="@string/stream_autoplay_on" />
            <ImageButton android:id="@+id/streamStop" style="@style/StreamPlayerIcon"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:src="@drawable/stream_stop" android:contentDescription="@string/stream_stop" />
            <ImageButton android:id="@+id/streamClose" style="@style/StreamPlayerIcon"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:src="@drawable/stream_close" android:contentDescription="@string/close" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
